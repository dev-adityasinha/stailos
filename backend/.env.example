SECRET_KEY=replace-with-openssl-rand-hex-32
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/pappu_crm
FRONTEND_ORIGIN=http://localhost:3000

# Email delivery. Leave as "console" for dev (writes to the email_outbox table).
# Set to "smtp" to deliver verification/reset/event emails for real — any
# standard SMTP host (Gmail with an App Password, Office 365, etc.), free,
# no third-party API dependency.
EMAIL_PROVIDER=console
# EMAIL_FROM=Pappu AI CRM <no-reply@yourdomain.com>

# --- smtp ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=app-specific-password   # Gmail: use an App Password, not your login password
# SMTP_USE_TLS=true
